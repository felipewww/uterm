# Copy to .env (setup.sh does this for you). Never commit .env.
MYSQL_DATABASE=echo_term
MYSQL_USER=echo_term
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only
MYSQL_PORT=33306

STT_PORT=18080
STT_THREADS=6
STT_MODEL_FILE=ggml-small.en.bin

TTS_PORT=18090
TTS_DEVICE=cpu
TTS_TORCH_THREADS=6

# Used by the desktop app (main process). Not stored in the database.
ECHO_TERM_DB_HOST=127.0.0.1
ECHO_TERM_DB_PORT=33306
ECHO_TERM_DB_NAME=echo_term
ECHO_TERM_DB_USER=echo_term
ECHO_TERM_DB_PASSWORD=change-me-local-only

# Gemini API key for cloud voice (optional). Get one at https://aistudio.google.com/apikey
# Only the uTerm app reads it; it is never passed to the agents it launches.
ECHO_TERM_GEMINI_API_KEY=
# OpenAI API key for cloud voice (optional). https://platform.openai.com/api-keys
ECHO_TERM_OPENAI_API_KEY=
