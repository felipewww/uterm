{
  "name": "uterm-desktop",
  "productName": "uTerm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipewww/uterm.git"
  },
  "homepage": "https://github.com/felipewww/uterm",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-enabled coding agent workspace",
  "main": "out/main/index.js",
  "author": "echo-term",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && MAC_ARCH=arm64 electron-builder --mac --config build/mac-config.cjs && MAC_ARCH=x64 electron-builder --mac --config build/mac-config.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.12.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "appId": "dev.uterm.desktop",
    "productName": "uTerm",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "../hooks",
        "to": "hooks",
        "filter": [
          "**/*",
          "!**/*.md"
        ]
      },
      {
        "from": "build/icon-window.png",
        "to": "icon-window.png"
      }
    ],
    "npmRebuild": true,
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "echo-term <echo-term@localhost>",
      "synopsis": "Voice-enabled coding agent workspace",
      "files": [
        "out/**",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/@img/*darwin*/**",
        "!node_modules/@img/sharp-wasm32/**",
        "!node_modules/onnxruntime-web/**"
      ],
      "extraResources": [
        {
          "from": "build/models",
          "to": "models"
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2t64 | libasound2"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "files": [
        "out/**",
        "package.json",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/@img/*linux*/**",
        "!node_modules/@img/sharp-wasm32/**"
      ],
      "extraResources": [
        {
          "from": "build/models",
          "to": "models"
        }
      ]
    },
    "afterPack": "build/afterPack.cjs"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "^0.35.5",
    "@img/sharp-darwin-x64": "^0.35.5",
    "@img/sharp-libvips-darwin-arm64": "^1.3.4",
    "@img/sharp-libvips-darwin-x64": "^1.3.4"
  }
}
