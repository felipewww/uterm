{
  "name": "echo-term-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-enabled coding agent workspace",
  "main": "out/main/index.js",
  "author": "echo-term",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "mysql2": "^3.24.6",
    "node-pty": "^1.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.12.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "appId": "dev.echoterm.desktop",
    "productName": "Echo-Term",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "../hooks",
        "to": "hooks",
        "filter": [
          "**/*",
          "!**/*.md"
        ]
      },
      {
        "from": "../database/migrations",
        "to": "database/migrations"
      },
      {
        "from": "build/icon-window.png",
        "to": "icon-window.png"
      }
    ],
    "npmRebuild": true,
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "echo-term <echo-term@localhost>",
      "synopsis": "Voice-enabled coding agent workspace"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2t64 | libasound2"
      ]
    }
  }
}
